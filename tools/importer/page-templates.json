{
  "metadata": {
    "projectType": "da"
  },
  "templates": [
    {
      "name": "nsman-magazine",
      "urls": [
        "https://www.safra.sg/nsman-magazine"
      ],
      "representativeUrl": "https://www.safra.sg/nsman-magazine",
      "description": "NSman Magazine landing page: promo banner carousel, centered title, article teaser card grid and eNSMAN logo",
      "urlPattern": "/*",
      "blocks": [
        {
          "name": "carousel-promo-banner",
          "instances": [
            ".carousel-banner.carousel-banner--hero",
            ".carousel-banner--hero .banner-slider"
          ]
        },
        {
          "name": "cards-article",
          "instances": [
            ".container-sm .rte.tohide",
            ".rte.tohide"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Promotional banner carousel",
          "selector": [
            ".carousel-banner.carousel-banner--hero"
          ],
          "style": null,
          "blocks": [
            "carousel-promo-banner"
          ],
          "defaultContent": []
        },
        {
          "id": "section-2",
          "name": "Magazine title",
          "selector": [
            ".carousel-banner--hero + .rte",
            "div.rte:has(> div > h1)"
          ],
          "style": "centered",
          "blocks": [],
          "defaultContent": [
            ".carousel-banner--hero + .rte h1"
          ]
        },
        {
          "id": "section-3",
          "name": "Top reads article listing",
          "selector": [
            ".container.container-sm"
          ],
          "style": null,
          "blocks": [
            "cards-article"
          ],
          "defaultContent": []
        },
        {
          "id": "section-4",
          "name": "eNSMAN logo",
          "selector": [
            ".container-sm + .rte",
            "div.rte:has(img[alt='eNSMAN Logo'])"
          ],
          "style": "centered",
          "blocks": [],
          "defaultContent": [
            "img[alt='eNSMAN Logo']"
          ]
        }
      ]
    },
    {
      "name": "nsman-article",
      "urls": [
        "https://www.safra.sg/nsman-magazine/Spotlight/editor-picks/2026/10/26/every-lap-counts-safra-swim-for-hope-2026",
        "https://www.safra.sg/nsman-magazine/fun-activities/Fun-activities/2026/10/23/pov-Clayface-film-review",
        "https://www.safra.sg/nsman-magazine/parenting/parenting/2026/10/21/press-play-on-purposeful-screen-time"
      ],
      "representativeUrl": "https://www.safra.sg/nsman-magazine/Spotlight/editor-picks/2026/10/26/every-lap-counts-safra-swim-for-hope-2026",
      "description": "NSman Magazine article page",
      "blocks": [
        {
          "name": "quote-photo-caption",
          "instances": [
            ".nsman-content-block > h5:has(img)"
          ]
        }
      ],
      "urlPattern": "/nsman-magazine/*/*/*/*/*/*",
      "sections": [
        {
          "id": "section-1",
          "name": "Magazine masthead",
          "selector": [
            "div.rte:has(h1)",
            "header.site-header ~ div.rte:has(strong)"
          ],
          "style": "centered",
          "blocks": [],
          "defaultContent": [
            "div.rte h1"
          ]
        },
        {
          "id": "section-2",
          "name": "Article",
          "selector": [
            ".container.container-xs"
          ],
          "style": null,
          "blocks": [
            "quote-photo-caption"
          ],
          "defaultContent": [
            ".nsman-story-headline",
            ".container-xs .lead",
            ".container-xs .mb-4",
            ".nsman-content-block"
          ]
        },
        {
          "id": "section-3",
          "name": "eNSMAN logo",
          "selector": [
            ".container-xs + .rte",
            "div.rte:has(img[alt='eNSMAN Logo'])"
          ],
          "style": "centered",
          "blocks": [],
          "defaultContent": [
            "img[alt='eNSMAN Logo']"
          ]
        }
      ]
    }
  ]
}
