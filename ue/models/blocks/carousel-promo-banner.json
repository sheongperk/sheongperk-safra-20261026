{
  "definitions": [
    {
      "title": "Carousel Promo Banner",
      "id": "carousel-promo-banner",
      "model": "carousel-promo-banner",
      "filter": "carousel-promo-banner",
      "plugins": {
        "da": {
          "rows": 0,
          "columns": 0
        }
      }
    },
    {
      "title": "Promo Banner Slide",
      "id": "carousel-promo-banner-slide",
      "model": "carousel-promo-banner-slide",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "image", "selector": "div:nth-child(1) picture>img[src]" },
            { "name": "imageAlt", "selector": "div:nth-child(1) picture>img[alt]" },
            { "name": "link", "selector": "div:nth-child(1)>a[href]" },
            { "name": "text", "selector": "div:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "carousel-promo-banner-slide",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Banner Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Banner Image Alt"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "link",
          "label": "Slide Link"
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "text",
          "label": "Text (optional)",
          "value": ""
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "carousel-promo-banner",
      "components": [
        "carousel-promo-banner-slide"
      ]
    }
  ]
}
